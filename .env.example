# Documentation sample only; Spring does not automatically read this file.
# Use scripts/Use-DevEnvironment.ps1 for the isolated local environment.
DB_URL=jdbc:mysql://127.0.0.1:13306/ai_teaching?sslMode=DISABLED&allowPublicKeyRetrieval=true
DB_USERNAME=ai_teaching
DB_PASSWORD=
SERVER_PORT=8080
# Username-only mode also requires loopback binding and an explicit local-development
# confirmation. Use scripts/Use-DevEnvironment.ps1 instead of copying those gates here.
USERNAME_ONLY_LOGIN_ENABLED=false
FILE_STORAGE_DIR=./.work/files
CLASSROOM_VIDEO_MAX_BYTES=1073741824
CLASSROOM_FFPROBE_PATH=ffprobe
CLASSROOM_MEDIA_PROBE_TIMEOUT_SECONDS=30
CLASSROOM_DURATION_TOLERANCE_MS=2000
CLASSROOM_MODULE_MAX_ATTEMPTS=4
# Local HTTP only; production HTTPS must set this to true (the application default).
SESSION_COOKIE_SECURE=false
# Public frontend configuration; never put secrets in VITE_*.
VITE_API_BASE_URL=/api/v1
DEV_API_TARGET=http://127.0.0.1:8080

# Internal classroom modules. Keep disabled until every value is supplied locally.
CLASSROOM_MODULE_INTEGRATION_ENABLED=false
CLASSROOM_PUBLIC_BASE_URL=http://127.0.0.1:8080
CLASSROOM_MEDIA_SIGNING_KEY=
TRANSCRIPTION_MODULE_BASE_URL=http://127.0.0.1:18082
TRANSCRIPTION_MODULE_BEARER_TOKEN=
TRANSCRIPTION_MODULE_PROVIDER_ID=transcription-bundled
TRANSCRIPTION_MODULE_VERSION=transcription-bundled-1.0.0
HEADUP_MODULE_BASE_URL=http://127.0.0.1:18083
HEADUP_MODULE_BEARER_TOKEN=
HEADUP_MODULE_PROVIDER_ID=head-up-bundled
HEADUP_MODULE_VERSION=head-up-bundled-1.0.0
HEADUP_MODULE_WINDOW_MS=10000
HEADUP_MODULE_DEFINITION_ID=head-up-attendance-qwen-vl-v2

# Aliyun classroom report. Default off; set in the backend process only after
# both internal modules are configured. Never put the API key in VITE_*.
CLASSROOM_REPORT_ENABLED=false
CLASSROOM_REPORT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CLASSROOM_REPORT_API_KEY=
CLASSROOM_REPORT_MODEL=qwen3.7-plus
CLASSROOM_REPORT_TIMEOUT_SECONDS=30
CLASSROOM_REPORT_MAX_OUTPUT_TOKENS=1024
CLASSROOM_REPORT_CALL_CEILING_CENTS=100
CLASSROOM_REPORT_TOTAL_CAP_CENTS=2000
