# ============================================================
#  爱教学 · 转写模块 —— 环境变量样例
# ------------------------------------------------------------
#  用法：复制本文件为 .env（.env 已在 .gitignore 中，不会被提交），
#        然后填入真实值。Spring 不会自动读取 .env，
#        通过 scripts/Use-Env.ps1 载入，或直接在 IDE/系统里设置环境变量。
#
#  ⚠️ 本文件 2026-09-15 重写过。旧版大量内容是「ASR 沙盒」时代的
#     （ASR_AUDIO_URL / ASR_PROBE_* / ASR_MAX_FILE_SIZE_BYTES / COS_* 等），
#     那些键在契约路径下【全部无效】，已删除。留着一堆按了没反应的开关
#     比没有更糟——它会让人以为自己配过了。
# ============================================================

# ============================================================
#  一、部署身份与鉴权（契约层，必须配）
# ============================================================
# 机器凭证，逗号分隔可配多把（便于轮换期双活）。
# ⚠️ 留空 = 失败关闭：所有 /api/v1 请求一律 401。
# 必须是随机长串，禁止进 Git / fixture / 日志。
MODULE_BEARER_TOKENS=

# 部署身份：主项目按值登记，改这里就等于换了一次实现版本。
# 主项目应读 /api/v1/health 拿实际值，不要抄默认值。
MODULE_PROVIDER_ID=transcription-local
MODULE_VERSION=transcription-1.0.0
SERVER_ADDRESS=127.0.0.1

# 容量边界声明（会出现在 /health 的 capabilities 里）
MAX_BODY_BYTES=1048576
MAX_SEGMENTS=20000
MAX_POLL_SECONDS=1800

# ============================================================
#  二、识别引擎（改 ASR_PROVIDER 一行即可切换）
# ============================================================
#   wand               = 腾讯云 TokenHub wand-asr-v1
#                        一个 Bearer Key；支持内联 base64 音频；
#                        ⚠️ 异步成功只给一个 SRT 链接（本模块会自动下载解析）
#   aliyun-filetrans   = 阿里云百炼非实时语音识别（★ 当前选定方案）
#                        ⚠️ 只接受公网 URL，必须先配 OSS 暂存（见第四节）
#   tencent            = 腾讯云标准 ASR
#                        ❌ 契约路径下不可用（只实现了 URL 提交，而契约路径走内联）
ASR_PROVIDER=aliyun-filetrans

# ---------- 阿里云百炼（ASR_PROVIDER=aliyun-filetrans） ----------
# API Key 获取：https://bailian.console.aliyun.com/ → API-KEY 管理
DASHSCOPE_API_KEY=

# 模型：必须用 filetrans 结尾的那个长音频档。
# ⚠️ qwen-audio-3.0-asr-flash（不带 filetrans）时长上限只有 5 分钟，
#    课堂录像会被直接拒绝；qwen3-asr-flash 更是只有 10MB。
ALIYUN_ASR_MODEL=qwen-audio-3.0-asr-flash-filetrans

# 基线地址。配了 workspace-id 时代码会改写为专属域名
#   https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/api/v1
# 实测：不配也能用公共域名跑通（2026-09-15 真机验证），
#       专属域名官方称更稳，生产建议配。
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
DASHSCOPE_WORKSPACE_ID=

# 语种提示短码（zh/en/ja/yue/ko/de/fr/ru），逗号分隔；留空 = 整个字段都不发。
# 实测 filetrans 接受该参数并正常出结果（官方参数表只列了 paraformer-v2，是文档滞后）。
# 中英混说的课建议开——但「被接受」不等于「更准」，要断言得用真实课堂音频做对照。
ALIYUN_ASR_LANGUAGE_HINTS=

# 说话人分离（仅支持单声道；本模块抽出的就是 16k 单声道，满足前提）。
# 实测开启后结果里会出现 speaker_id 字段。
ALIYUN_ASR_DIARIZATION=false
# 说话人数参考值 2-100；0 = 不传、由算法自判。
# 实测传越界值（1）不报错也不生效，服务端不校验。
ALIYUN_ASR_SPEAKER_COUNT=0

# 定制热词表 ID。
# ⚠️ 实测：传一个不存在的 ID 不报错、任务照常成功（静默忽略），
#    所以热词配错了不会有任何提示，只能靠识别结果自己发现。
ALIYUN_ASR_VOCABULARY_ID=
# 要识别的音轨索引。代码会包装成数组发给阿里云
# （发标量时提交返回 HTTP 200，任务却在异步阶段失败，2026-09-15 实测）。
ALIYUN_ASR_CHANNEL_ID=0

# ---------- 腾讯云 TokenHub（ASR_PROVIDER=wand） ----------
# API Key 获取：https://console.cloud.tencent.com/tokenhub/apikey
# ⚠️ 还需在 https://console.cloud.tencent.com/tokenhub/inference 开通后付费或领额度，
#    否则提交返回 402（401007：无可用免费额度且未开启后付费）
WAND_API_KEY=
WAND_BASE_URL=https://tokenhub.tencentmaas.com
WAND_MODEL=wand-asr-v1

# ---------- 腾讯云标准 ASR（ASR_PROVIDER=tencent，契约路径下不可用） ----------
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_REGION=ap-guangzhou

# ---------- 通用于所有提供方 ----------
ASR_CONNECT_TIMEOUT_SECONDS=10
ASR_READ_TIMEOUT_SECONDS=120
ASR_POLL_ENABLED=true
# 轮询间隔。阿里云实测 3.9 秒音频 2.3-3.6 秒完成，5 秒间隔够用。
ASR_POLL_INTERVAL=5s
# 持久任务轮询期限；瞬时超时/5xx 在期限内继续查询，不重复提交供应商任务。
ASR_POLL_TIMEOUT=PT2H
ASR_INLINE_MAX_BYTES=67108864
ASR_DEBUG_DUMP_RAW_RESULT=false
ASR_DEBUG_DUMP_DIR=./.work/asr-raw

# ============================================================
#  三、媒体获取与音轨提取
# ============================================================
MEDIA_WORK_DIR=./.work/media
FFMPEG_PATH=./.work/tools/ffmpeg/bin/ffmpeg.exe
FFPROBE_PATH=./.work/tools/ffmpeg/bin/ffprobe.exe
MEDIA_CONNECT_TIMEOUT=10
MEDIA_DOWNLOAD_TIMEOUT=600
MEDIA_PROBE_TIMEOUT=180
# 长媒体抽音轨单独使用更长上限，不与 ffprobe 的短超时共用。
MEDIA_EXTRACT_TIMEOUT=7200
# 进程异常退出留下的本地媒体目录，到期由启动及定时清理器删除。
MEDIA_ORPHAN_RETENTION_HOURS=24
MEDIA_CLEANUP_INTERVAL_MS=3600000
# 单次下载上限 2GB。注意这与「阿里云单文件 2GB 上限」是两回事：
# 我们提交给阿里云的是抽出的音轨，不是原始录像。
MEDIA_MAX_DOWNLOAD_BYTES=2147483648
# 允许的最大媒体时长 2 小时；超过返回 422
MEDIA_MAX_DURATION_MS=7200000
# 主机白名单，逗号分隔；留空 = 不限（仍拒绝内网/环回/链路本地）
MEDIA_HOST_ALLOW_LIST=
# ⚠️ 仅本地联调可开；生产必须 false
MEDIA_ALLOW_LOOPBACK_HTTP=false
MEDIA_DURATION_TOLERANCE_MS=2000
MEDIA_KEEP_FILES=false

# ============================================================
#  四、对象存储暂存（阿里云 OSS）
# ============================================================
#  为什么需要：阿里云 filetrans 长音频档【只接受公网可访问的 URL】，
#  官方 FAQ 原文「不支持Base64编码方式的音频…不支持二进制流，
#  也不支持直接识别本地文件」。所以抽好的音轨必须先暂存出去。
#
#  oss 模式会把不含凭证的对象键持久化到任务行，供应商终态或恢复完成后按键删除；
#  桶生命周期仍建议作为异常情况下的最后兜底。
#
#  ⚠️ 安全：OSS AccessKey 的权限远大于一枚 API Key（可读写整个 bucket）。
#     请务必用 RAM 子账号 + 只授权「这一个 bucket 的这一个前缀」，
#     不要用主账号 AccessKey。
STAGING_TYPE=oss

# RAM 子账号密钥（建议权限：仅 oss:PutObject / oss:GetObject / oss:DeleteObject，
# 资源限定为 arn:acs:oss:*:*:{bucket}/videoreact/staging/*）
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# 存储桶名（不要带 .oss-cn-beijing.aliyuncs.com 后缀，只填桶名本身）
OSS_BUCKET=
# 地域：必须与百炼调用地域一致（华北2 = cn-beijing），跨地域拉取会慢。
OSS_REGION=cn-beijing
# 对象前缀，末尾斜杠会被自动补上。
# 建议单独开一个前缀，便于配生命周期规则自动清理。
OSS_PREFIX=videoreact/staging/

# 端点。留空则按 OSS_REGION 推导为 https://oss-{region}.aliyuncs.com
# ⚠️ public-endpoint 是【写进预签名 URL、由百炼服务器访问】的地址，必须是 HTTPS 公网地址。
OSS_PUBLIC_ENDPOINT=
# 模块部署在阿里云 ECS 上时可填内网端点省流量（如
# https://oss-cn-beijing-internal.aliyuncs.com）；留空则用公网端点。
OSS_INTERNAL_ENDPOINT=

# 预签名 URL 有效期（秒）。必须覆盖「排队 + 识别 + 轮询」全过程：
# 地址在任务中途失效，任务会以一个含糊的下载失败告终。
# 默认 10800（3 小时）= 轮询上限 2 小时 × 1.5
OSS_URL_EXPIRY_SECONDS=10800

# 超过该字节数的对象改用分片上传（支持断点续传，避免大文件整传失败）。
# 45 分钟课堂音轨压成 MP3 约 11MB，正常不会触发；保留给「直传原始录像」的实验路径。
OSS_MULTIPART_THRESHOLD_BYTES=104857600
# 分片大小（5MB ~ 5GB，OSS 限制）
OSS_MULTIPART_PART_SIZE_BYTES=10485760
# 上传/删除操作超时（秒）
OSS_TIMEOUT_SECONDS=300
# 失败时是否重试（OSS 侧 5xx 与网络抖动）
OSS_MAX_RETRIES=3

# ============================================================
#  五、本地服务
# ============================================================
# ⚠️ 本机 8080 被系统保留（Python 绑定直接 WinError 10013，且 netstat 看不到占用者），
#    本地跑建议换端口。
SERVER_PORT=18080

# 数据库：模块自己的库（契约明确「模块不访问主库」）
DB_URL=jdbc:h2:file:./.data/transcription;MODE=MySQL;DATABASE_TO_LOWER=TRUE;DEFAULT_NULL_ORDERING=HIGH;AUTO_SERVER=TRUE
DB_USERNAME=sa
DB_PASSWORD=
DB_DRIVER=org.h2.Driver

# ============================================================
#  六、课程热词（⚠️ 当前未接线，配了也不生效）
# ============================================================
# JobRunner 目前不构造热词（hotwordList 传 null）。
# 注意：换成阿里云后这条才有使用点（TokenHub 路径不吃热词），
#       但接线本身还没做，见 README §7 已知限制第 6 条。
ASR_HOTWORD_DEFAULT_WEIGHT=10
ASR_HOTWORD_LIST_MAX_SIZE=128
ASR_HOTWORD_MAX_WORD_LENGTH=30
