# 抬头率模块（HEAD_UP）· 本地联调配置
# 用法：复制为 .env 后用 scripts/Use-Env.ps1 载入（本模块不会自动读取 .env）
# 说明：这份文件只列**契约联调必需/相关**的项；完整清单见 README §5。

# ── 部署身份（主项目按值登记，改这里等于换一次实现版本）──
MODULE_PROVIDER_ID=head-up-local
MODULE_VERSION=head-up-0.1.0

# ── 机器凭证（必须配！留空 = 失败关闭：所有 /api/v1 请求 401）──
# 逗号分隔可配多把，便于轮换期双活；必须是随机长串，禁止进 Git / fixture / 日志
MODULE_BEARER_TOKENS=change-me-to-a-long-random-string

# ── 服务与库 ──
SERVER_HOST=127.0.0.1
SERVER_PORT=8080
DB_PATH=./.data/headup.sqlite3
WORK_DIR=./.work
WORKERS=1

# ── 观测口径（definitionId 与口径文本必须成对；内置口径见 src/headup/definitions.py）──
HEADUP_DEFINITION_ID=head-up-attendance-qwen-vl-v2
HEADUP_SAMPLE_POSITION=middle

# ── 外部工具（统一启动脚本使用本项目私有工具目录）──
# FFMPEG_PATH=../../.work/tools/ffmpeg/ffmpeg.exe
# FFPROBE_PATH=../../.work/tools/ffmpeg/ffprobe.exe

# ── 视觉判定（阿里云百炼 / DashScope，OpenAI 兼容路径）──
# 未配置 DASHSCOPE_API_KEY 时不会编造人数：任务会显式失败或按配置降级
VISION_PROVIDER=qwen-vl
VISION_MODEL=qwen3-vl-plus
VISION_FALLBACK_MODEL=qwen3-vl-flash
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=

# ── 抽帧与分块 ──
FRAME_MAX_WIDTH=1600
FRAME_TILE_GRID=1x1
MIN_LEGIBLE_RATIO=0.60

# ── 合成 provider（仅结构联调；默认关闭）──
# 开启后只对已登记演示身份 session-demo-001 / media-demo-001 / 64×a 输出人工合成观测
ENABLE_FIXTURE_PROVIDER=false

# ── 本地联调专用（生产必须保持 false）──
MEDIA_ALLOW_LOOPBACK_HTTP=false
# 只允许从这些主机下载（留空=不限，但仍拒绝内网/环回）
MEDIA_HOST_ALLOW_LIST=
MEDIA_CONNECT_TIMEOUT=10
MEDIA_DOWNLOAD_TIMEOUT=600
# 整次下载的总墙钟上限，慢速滴流也不能无限占用 worker。
MEDIA_TOTAL_TIMEOUT=900

# ── 上限（会被强制执行）──
MAX_BODY_BYTES=2097152
MEDIA_MAX_DOWNLOAD_BYTES=2147483648
MEDIA_MAX_DURATION_MS=7200000
MAX_WINDOWS=20000
HEADUP_FAILED_TASK_RETENTION_HOURS=12
# 0=成功后全删；N=只保留恰好 N 张帧用于受控调试。
FRAMES_RETAIN=0
